{
  "name": "cse-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:image-backgrounds": "node scripts/generate-image-backgrounds.mjs",
    "predev": "npm run generate:image-backgrounds",
    "dev": "node scripts/dev-bilingual-site.mjs",
    "prebuild": "npm run generate:image-backgrounds",
    "build:next": "node scripts/build-bilingual-site.mjs",
    "build": "npm run build:next && node scripts/prepare-sites-build.mjs",
    "build:sites": "npm run build",
    "typecheck": "tsc --noEmit",
    "seo:audit": "node scripts/seo-audit.mjs",
    "performance:audit": "node scripts/performance-budget.mjs",
    "verify:seo": "npm run lint && npm run typecheck && npm run test:inquiry && npm run build && npm run seo:audit && npm run performance:audit",
    "db:generate": "drizzle-kit generate",
    "test:inquiry": "node scripts/test-inquiry-worker.mjs",
    "lint": "eslint .",
    "version:check": "node scripts/check-version.mjs",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "release:major": "npm version major -m \"chore(release): v%s\"",
    "preversion": "npm run lint && npm run typecheck",
    "version": "npm run version:check"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.127.0"
  }
}
